/* =============================================
   Git-Commit Storyteller - Modern Styles
   ============================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    /* Colors */
    --bg-primary: #0a0e27;
    --bg-secondary: #141829;
    --bg-tertiary: #1a1f3a;
    --surface: rgba(30, 41, 82, 0.3);
    --surface-light: rgba(59, 89, 192, 0.15);
    --border: rgba(139, 169, 255, 0.2);
    --border-light: rgba(139, 169, 255, 0.1);
    --text-primary: #e0e6ff;
    --text-secondary: #8b9aff;
    --text-tertiary: #5a6b8f;
    --accent-primary: #6b5eff;
    --accent-secondary: #ff6b6b;
    --accent-tertiary: #4ecdc4;
    --glow-primary: rgba(107, 94, 255, 0.5);
    --glow-secondary: rgba(255, 107, 107, 0.5);

    /* Spacing */
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 1.5rem;
    --spacing-lg: 2rem;
    --spacing-xl: 3rem;

    /* Border Radius */
    --radius-sm: 0.5rem;
    --radius-md: 1rem;
    --radius-lg: 1.5rem;

    /* Transitions */
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

html, body {
    width: 100%;
    height: 100%;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
        'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
        sans-serif;
    background: var(--bg-primary);
    color: var(--text-primary);
    overflow: hidden;
}

/* =============================================
   Layout
   ============================================= */

.container {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.header {
    background: linear-gradient(135deg, rgba(30, 41, 82, 0.5) 0%, rgba(59, 89, 192, 0.1) 100%);
    border-bottom: 1px solid var(--border);
    padding: var(--spacing-md) var(--spacing-lg);
    backdrop-filter: blur(10px);
}

.header-content {
    max-width: 1400px;
    margin: 0 auto;
}

.logo {
    font-size: 1.8rem;
    font-weight: 700;
    background: linear-gradient(135deg, #6b5eff, #4ecdc4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.logo-icon {
    font-size: 2rem;
}

.tagline {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-top: var(--spacing-xs);
}

.main-content {
    flex: 1;
    display: grid;
    grid-template-columns: 280px 1fr 300px;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    overflow: hidden;
}

/* =============================================
   Panels
   ============================================= */

.control-panel,
.info-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md);
    overflow-y: auto;
    backdrop-filter: blur(10px);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
}

.control-panel::-webkit-scrollbar,
.info-panel::-webkit-scrollbar,
.drawer-content::-webkit-scrollbar {
    width: 6px;
}

.control-panel::-webkit-scrollbar-track,
.info-panel::-webkit-scrollbar-track,
.drawer-content::-webkit-scrollbar-track {
    background: transparent;
}

.control-panel::-webkit-scrollbar-thumb,
.info-panel::-webkit-scrollbar-thumb,
.drawer-content::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 3px;
}

.control-panel::-webkit-scrollbar-thumb:hover,
.info-panel::-webkit-scrollbar-thumb:hover,
.drawer-content::-webkit-scrollbar-thumb:hover {
    background: var(--border-light);
}

.panel-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
}

.input-label,
.section-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* =============================================
   Forms & Inputs
   ============================================= */

.input-group {
    display: flex;
    gap: var(--spacing-sm);
}

.repo-input {
    flex: 1;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm) var(--spacing-md);
    color: var(--text-primary);
    font-size: 0.9rem;
    transition: var(--transition);
}

.repo-input:focus {
    outline: none;
    border-color: var(--accent-primary);
    background: var(--surface-light);
    box-shadow: 0 0 20px var(--glow-primary);
}

.repo-input::placeholder {
    color: var(--text-tertiary);
}

/* =============================================
   Buttons
   ============================================= */

.btn {
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
    white-space: nowrap;
}

.btn:hover {
    border-color: var(--accent-primary);
    background: var(--surface-light);
}

.btn-primary {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: white;
}

.btn-primary:hover {
    background: linear-gradient(135deg, var(--accent-primary), #5a4eff);
    box-shadow: 0 0 20px var(--glow-primary);
}

.btn-secondary {
    width: 100%;
    background: linear-gradient(135deg, rgba(107, 94, 255, 0.2), rgba(78, 205, 196, 0.2));
    border-color: var(--accent-primary);
}

.btn-secondary:hover {
    background: linear-gradient(135deg, rgba(107, 94, 255, 0.3), rgba(78, 205, 196, 0.3));
    box-shadow: 0 0 15px var(--glow-primary);
}

.demo-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
}

.btn-demo {
    padding: var(--spacing-xs) var(--spacing-sm);
    font-size: 0.8rem;
}

.btn-icon {
    background: none;
    border: none;
    color: var(--text-primary);
    font-size: 1.2rem;
    cursor: pointer;
    padding: var(--spacing-sm);
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
}

.btn-icon:hover {
    color: var(--accent-primary);
    text-shadow: 0 0 10px var(--glow-primary);
}

.btn-speed {
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: var(--transition);
}

.btn-speed.active {
    background: var(--accent-primary);
    color: white;
    border-color: var(--accent-primary);
}

.btn-speed:hover {
    border-color: var(--accent-primary);
    color: var(--text-primary);
}

.btn-close {
    background: none;
    border: none;
    color: var(--text-primary);
    font-size: 1.5rem;
    cursor: pointer;
    transition: var(--transition);
}

.btn-close:hover {
    color: var(--accent-secondary);
}

/* =============================================
   Stats & Info
   ============================================= */

.stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
}

.stat-box {
    background: var(--surface-light);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
    text-align: center;
}

.stat-label {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: var(--spacing-xs);
}

.stat-value {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--accent-primary);
}

.commit-info {
    background: var(--surface-light);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
    font-size: 0.9rem;
}

.commit-hash {
    font-family: 'Monaco', 'Courier New', monospace;
    color: var(--accent-tertiary);
    word-break: break-all;
    margin-bottom: var(--spacing-sm);
}

.commit-author {
    color: var(--text-secondary);
    margin-bottom: var(--spacing-xs);
    font-weight: 600;
}

.commit-date {
    font-size: 0.85rem;
    color: var(--text-tertiary);
}

.contributors-mini {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
}

.contributor-mini {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm);
    background: var(--surface-light);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-light);
    font-size: 0.85rem;
}

.contributor-mini-name {
    color: var(--text-primary);
    font-weight: 600;
}

.contributor-mini-count {
    color: var(--accent-primary);
    font-weight: 700;
}

.empty-state {
    color: var(--text-tertiary);
    font-size: 0.9rem;
    text-align: center;
    padding: var(--spacing-md);
}

/* =============================================
   Canvas Section
   ============================================= */

.canvas-section {
    display: flex;
    flex-direction: column;
    position: relative;
    grid-column: 2;
    min-height: 0;
}

.canvas-container {
    flex: 1;
    position: relative;
    background: radial-gradient(ellipse at 50% 50%, rgba(59, 89, 192, 0.1) 0%, transparent 70%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    backdrop-filter: blur(10px);
}

.commit-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: crosshair;
}

.canvas-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
}

.spinner {
    width: 50px;
    height: 50px;
    border: 4px solid var(--border);
    border-top-color: var(--accent-primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

.spinner.hidden {
    display: none;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.error-message {
    background: rgba(255, 107, 107, 0.15);
    border: 1px solid var(--accent-secondary);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
    color: #ff9999;
    text-align: center;
    max-width: 80%;
    pointer-events: auto;
}

.error-message.hidden {
    display: none;
}

/* =============================================
   Story HUD
   ============================================= */

.story-hud {
    background: linear-gradient(135deg, rgba(30, 41, 82, 0.4) 0%, rgba(59, 89, 192, 0.15) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md);
    margin-top: var(--spacing-md);
    backdrop-filter: blur(10px);
    min-height: 120px;
    display: flex;
    align-items: center;
}

.story-content {
    width: 100%;
}

.story-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent-primary);
    margin-bottom: var(--spacing-xs);
}

.story-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    line-height: 1.5;
    margin-bottom: var(--spacing-sm);
}

.story-meta {
    font-size: 0.8rem;
    color: var(--text-tertiary);
}

/* =============================================
   Timeline Player
   ============================================= */

.timeline-player {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: var(--spacing-md) var(--spacing-lg);
    backdrop-filter: blur(10px);
}

.player-controls {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    max-width: 1400px;
    margin: 0 auto;
}

.timeline-scrubber {
    flex: 1;
    position: relative;
    height: 4px;
    background: var(--bg-tertiary);
    border-radius: 2px;
    cursor: pointer;
}

.timeline-input {
    position: absolute;
    inset: -8px;
    width: 100%;
    height: calc(100% + 16px);
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    cursor: pointer;
    z-index: 5;
}

.timeline-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    background: var(--accent-primary);
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 0 10px var(--glow-primary);
}

.timeline-input::-moz-range-thumb {
    width: 16px;
    height: 16px;
    background: var(--accent-primary);
    border-radius: 50%;
    cursor: pointer;
    border: none;
    box-shadow: 0 0 10px var(--glow-primary);
}

.timeline-progress {
    position: absolute;
    height: 100%;
    background: var(--accent-primary);
    border-radius: 2px;
    width: 0%;
    pointer-events: none;
}

.time-display {
    font-size: 0.9rem;
    color: var(--text-secondary);
    min-width: 100px;
    font-family: 'Monaco', 'Courier New', monospace;
}

.speed-control {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.speed-label {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
}

/* =============================================
   Drawer (Leaderboard)
   ============================================= */

.drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    z-index: 998;
    backdrop-filter: blur(4px);
}

.drawer-overlay.hidden {
    display: none;
}

.drawer {
    position: fixed;
    right: 0;
    top: 0;
    width: 400px;
    height: 100%;
    background: var(--bg-secondary);
    border-left: 1px solid var(--border);
    z-index: 999;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: var(--transition);
}

.drawer.hidden {
    display: none;
}

.drawer:not(.hidden) {
    transform: translateX(0);
}

.drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-lg);
    border-bottom: 1px solid var(--border);
}

.drawer-header h2 {
    font-size: 1.3rem;
}

.drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: var(--spacing-lg);
}

.leaderboard-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
}

.leaderboard-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: var(--transition);
}

.leaderboard-item:hover {
    background: var(--surface-light);
    border-color: var(--accent-primary);
}

.leaderboard-rank {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--accent-primary);
    min-width: 40px;
}

.leaderboard-rank.gold {
    color: #ffd700;
}

.leaderboard-rank.silver {
    color: #c0c0c0;
}

.leaderboard-rank.bronze {
    color: #cd7f32;
}

.leaderboard-info {
    flex: 1;
    min-width: 0;
}

.leaderboard-name {
    font-weight: 600;
    color: var(--text-primary);
    word-break: break-word;
}

.leaderboard-commits {
    font-size: 0.85rem;
    color: var(--text-tertiary);
}

.leaderboard-count {
    font-weight: 700;
    color: var(--accent-primary);
    font-size: 1.2rem;
}

/* =============================================
   Responsive Design
   ============================================= */

@media (max-width: 1200px) {
    .main-content {
        grid-template-columns: 1fr 250px;
    }

    .control-panel {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: var(--spacing-md);
    }

    .panel-section {
        gap: var(--spacing-xs);
    }
}

@media (max-width: 768px) {
    .container {
        height: auto;
        flex-direction: column;
        min-height: 100vh;
    }

    .header {
        padding: var(--spacing-md);
    }

    .main-content {
        grid-template-columns: 1fr;
        gap: var(--spacing-sm);
        padding: var(--spacing-sm);
        min-height: 600px;
    }

    .canvas-section {
        grid-column: 1;
        order: 2;
    }

    .control-panel,
    .info-panel {
        grid-column: 1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        order: 1;
        padding: var(--spacing-sm);
    }

    .control-panel {
        order: 1;
    }

    .info-panel {
        order: 3;
    }

    .panel-section {
        grid-column: 1 / -1;
    }

    .demo-buttons {
        grid-template-columns: 1fr 1fr;
    }

    .timeline-player {
        padding: var(--spacing-sm);
    }

    .player-controls {
        flex-wrap: wrap;
        gap: var(--spacing-sm);
    }

    .speed-control {
        grid-column: 1 / -1;
        width: 100%;
        justify-content: space-around;
    }

    .drawer {
        width: 100%;
    }

    .logo {
        font-size: 1.4rem;
    }

    .story-hud {
        min-height: auto;
        padding: var(--spacing-sm);
    }
}

@media (max-width: 480px) {
    .header {
        padding: var(--spacing-sm);
    }

    .logo {
        font-size: 1.2rem;
    }

    .tagline {
        font-size: 0.8rem;
    }

    .main-content {
        padding: var(--spacing-xs);
        gap: var(--spacing-xs);
    }

    .control-panel,
    .info-panel {
        grid-template-columns: 1fr;
        padding: var(--spacing-xs);
    }

    .demo-buttons {
        grid-template-columns: 1fr;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .btn {
        padding: var(--spacing-xs) var(--spacing-sm);
        font-size: 0.8rem;
    }

    .player-controls {
        flex-wrap: wrap;
    }

    .speed-control {
        order: -1;
        grid-column: 1 / -1;
        width: 100%;
    }

    .btn-speed {
        flex: 1;
        min-width: 50px;
    }
}

/* =============================================
   Animations
   ============================================= */

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes pulse {
    0%, 100% {
        opacity: 1;
    }
    50% {
        opacity: 0.5;
    }
}

@keyframes glow {
    0%, 100% {
        box-shadow: 0 0 10px var(--glow-primary);
    }
    50% {
        box-shadow: 0 0 20px var(--glow-primary);
    }
}

.story-hud {
    animation: fadeIn 0.5s ease-in-out;
}
